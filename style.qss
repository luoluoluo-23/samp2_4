/* ------------------------------------------------------------------
 * 简约灰白主题（Qt Style Sheets）
 * 只保留灰、白两色，靠明暗和边框区分按键类别，不使用彩色。
 * ------------------------------------------------------------------ */

/* 窗口背景 */
QMainWindow,
QWidget#centralwidget {
    background-color: #f2f2f2;
}

/* 显示区上方的小字（算式提示） */
QLabel#expressionLabel {
    color: #888888;
    padding-right: 12px;
}

/* 主显示区：白底 + 浅灰边框 */
QLineEdit#display {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    border-radius: 6px;
    color: #222222;
    padding-right: 10px;
}

/* 所有按键的公共样式 */
QPushButton {
    background-color: #fafafa;
    border: 1px solid #cccccc;
    border-radius: 6px;
    color: #222222;
    font-size: 22px;
}

QPushButton:hover {
    background-color: #eeeeee;
}

QPushButton:pressed {
    background-color: #dedede;
}

/* 功能键：C、←、%、± —— 比数字键稍深一点 */
QPushButton#btn_clear_all,
QPushButton#btn_backspace,
QPushButton#btn_percent,
QPushButton#btn_sign {
    background-color: #e8e8e8;
}

QPushButton#btn_clear_all:hover,
QPushButton#btn_backspace:hover,
QPushButton#btn_percent:hover,
QPushButton#btn_sign:hover {
    background-color: #dcdcdc;
}

QPushButton#btn_clear_all:pressed,
QPushButton#btn_backspace:pressed,
QPushButton#btn_percent:pressed,
QPushButton#btn_sign:pressed {
    background-color: #cfcfcf;
}

/* 运算符：÷ × - + = —— 再深一档，字号略大 */
QPushButton#btn_divide,
QPushButton#btn_multiply,
QPushButton#btn_minus,
QPushButton#btn_plus,
QPushButton#btn_equals {
    background-color: #dcdcdc;
    font-size: 24px;
}

QPushButton#btn_divide:hover,
QPushButton#btn_multiply:hover,
QPushButton#btn_minus:hover,
QPushButton#btn_plus:hover,
QPushButton#btn_equals:hover {
    background-color: #d0d0d0;
}

QPushButton#btn_divide:pressed,
QPushButton#btn_multiply:pressed,
QPushButton#btn_minus:pressed,
QPushButton#btn_plus:pressed,
QPushButton#btn_equals:pressed {
    background-color: #c4c4c4;
}
